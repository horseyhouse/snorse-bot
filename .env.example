# Signal account registered in the signal-api persistent volume.
BOT_PHONE_NUMBER=+15555550100
BOT_DISPLAY_NAME=signal-reminder-bot

# Provider-neutral state service implementing docs/state-api.md.
STATE_API_URL=http://host.docker.internal:9000
STATE_API_TOKEN=replace-with-a-long-random-token

# Docker Compose connects to the bundled Signal REST API by this service name.
SIGNAL_BASE_API_URL=http://signal-api:8080

# Optional stable Signal address and calendar-link help address.
BOT_SIGNAL_UUID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
