# Signal account registered in the signal-api persistent volume.
BOT_PHONE_NUMBER=+15555550100
BOT_DISPLAY_NAME=signal-reminder-bot
BOT_SIGNAL_UUID=

# Bundled services.
SIGNAL_BASE_API_URL=http://signal-api:8080
STATE_API_URL=http://state:8090
STATE_API_TOKEN=replace-with-a-long-random-token

# Optional calendar integration and public shared-host settings.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
PUBLIC_SITE_URL=https://snorse.com
SUPPORT_URL=
MAX_ACTIVE_GROUPS=1000000
MAX_PERSONAL_USERS=1000000
ADMISSION_MODE=auto
